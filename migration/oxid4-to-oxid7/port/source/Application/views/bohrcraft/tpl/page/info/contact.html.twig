{% capture append = "oxidBlock_content" %}
{% if oView.getContactSendStatus() %}{% include "message/success.html.twig" with {statusMessage: (oView.getActiveLangAbbr() == 'en' ? 'Thank you. Your message has been sent.' : 'Vielen Dank. Deine Nachricht wurde versendet.')} %}{% endif %}
<div class="container-xxl py-4 bohrcraft-contact-page"><h1>{{ translate({ ident: "DD_CONTACT_PAGE_HEADING" }) }}</h1>{% include_content "oxkontaktlinks" ignore missing %}
<div class="row g-5 mt-2"><div class="col-12 col-lg-8"><h2 class="h3">{{ translate({ ident: "DD_CONTACT_FORM_HEADING" }) }}</h2>{% include "form/contact.html.twig" with {contactController: "contact"} %}</div><div class="col-12 col-lg-4"><h2 class="h3">{{ translate({ ident: "ADDRESS" }) }}</h2>{% include_content "oxcompanyadress" ignore missing %}</div></div>
{% set mapAddress = oViewConf.getViewThemeParam('sGoogleMapsAddr') %}{% if mapAddress %}<div class="bohrcraft-external mt-5" data-external-provider="map" data-external-src="https://www.google.com/maps?q={{ mapAddress|urlencode }}&amp;output=embed"><h2 class="h3">{% if oView.getActiveLangAbbr() == 'en' %}Directions{% else %}Anfahrt{% endif %}</h2><p>{% if oView.getActiveLangAbbr() == 'en' %}The map is loaded from Google only after your click.{% else %}Die Karte wird erst nach deinem Klick von Google geladen.{% endif %}</p><button class="btn btn-primary" type="button" data-load-external="map">{% if oView.getActiveLangAbbr() == 'en' %}Load map{% else %}Karte laden{% endif %}</button></div>{% endif %}
</div>{{ insert_tracker({title: template_title}) }}{% endcapture %}
{% capture append = "oxidBlock_pageScript" %}<script src="{{ oViewConf.getResourceUrl('js/bohrcraft.js')|raw }}" defer></script>{% endcapture %}
{% include "layout/page.html.twig" %}
