{% if not oView.getContactSendStatus() %}{% set editval = oView.getUserData() %}{% endif %}
{% set targetController = contactController|default("contact") %}
<form class="needs-validation bohrcraft-contact" action="{{ oViewConf.getSslSelfLink()|raw }}" method="post">
{{ oViewConf.getHiddenSid()|raw }}<input type="hidden" name="fnc" value="send"><input type="hidden" name="cl" value="{{ targetController }}">
<div class="row g-3">
<div class="col-md-6"><label class="form-label req" for="contact-firstname">{{ translate({ ident: "FIRST_NAME" }) }}</label><input class="form-control" id="contact-firstname" name="editval[oxuser__oxfname]" maxlength="80" value="{{ editval.oxuser__oxfname }}" required></div>
<div class="col-md-6"><label class="form-label req" for="contact-lastname">{{ translate({ ident: "LAST_NAME" }) }}</label><input class="form-control" id="contact-lastname" name="editval[oxuser__oxlname]" maxlength="80" value="{{ editval.oxuser__oxlname }}" required></div>
<div class="col-12"><label class="form-label" for="contact-company">{{ translate({ ident: "COMPANY" }) }}</label><input class="form-control" id="contact-company" name="editval[oxuser__oxcompany]" maxlength="120" value="{{ editval.oxuser__oxcompany }}"></div>
<div class="col-md-8"><label class="form-label req" for="contact-street">{{ translate({ ident: "STREET_AND_STREETNO" }) }}</label><input class="form-control" id="contact-street" name="editval[oxuser__oxstreet]" maxlength="120" value="{{ editval.oxuser__oxstreet }}" required></div>
<div class="col-md-4"><label class="form-label req" for="contact-postcode">{{ translate({ ident: "POSTAL_CODE" }) }}</label><input class="form-control" id="contact-postcode" name="editval[oxuser__postcode]" maxlength="20" value="{{ editval.oxuser__postcode }}" required></div>
<div class="col-md-6"><label class="form-label req" for="contact-city">{{ translate({ ident: "POSTAL_CITY" }) }}</label><input class="form-control" id="contact-city" name="editval[oxuser__city]" maxlength="80" value="{{ editval.oxuser__city }}" required></div>
<div class="col-md-6"><label class="form-label req" for="contact-country">{{ translate({ ident: "COUNTRY" }) }}</label><input class="form-control" id="contact-country" name="editval[oxuser__country]" maxlength="80" value="{{ editval.oxuser__country }}" required></div>
<div class="col-md-6"><label class="form-label req" for="contact-phone">{{ translate({ ident: "PHONE" }) }}</label><input class="form-control" id="contact-phone" name="editval[oxuser__oxfon]" maxlength="60" value="{{ editval.oxuser__oxfon }}" required></div>
<div class="col-md-6"><label class="form-label req" for="contact-email">{{ translate({ ident: "EMAIL" }) }}</label><input class="form-control" id="contact-email" type="email" name="editval[oxuser__oxusername]" maxlength="120" value="{{ editval.oxuser__oxusername }}" required></div>
<div class="col-md-6"><label class="form-label" for="contact-iam">{% if oView.getActiveLangAbbr() == 'en' %}I am{% else %}Ich bin{% endif %}</label><select class="form-select" id="contact-iam" name="editval[oxuser__oxiam]"><option value=""></option><option>Fachhändler</option><option>Handwerker</option><option>Industrie</option><option>Privatkunde</option><option>Sonstige</option></select></div>
<div class="col-md-6"><label class="form-label req" for="contact-subject">{{ translate({ ident: "SUBJECT" }) }}</label><input class="form-control" id="contact-subject" name="c_subject" maxlength="120" value="{{ contactSubject|default(oView.getContactSubject()) }}" required></div>
<div class="col-12"><label class="form-label" for="contact-message">{{ translate({ ident: "MESSAGE" }) }}</label><textarea class="form-control" id="contact-message" name="c_message" rows="8">{{ oView.getContactMessage() }}</textarea></div>
<div class="col-12"><div class="form-check"><input class="form-check-input" id="contact-privacy" type="checkbox" name="c_oegdproptin" value="1" required><label class="form-check-label req" for="contact-privacy">{% if oView.getActiveLangAbbr() == 'en' %}I have read the privacy policy and agree to the processing of my information for this request.{% else %}Ich habe die Datenschutzerklärung gelesen und stimme der Verarbeitung meiner Angaben für diese Anfrage zu.{% endif %}</label></div></div>
<div class="col-12"><p class="small">{{ translate({ ident: "COMPLETE_MARKED_FIELDS" }) }}</p><button class="btn btn-primary" type="submit">{{ translate({ ident: "SEND" }) }}</button></div>
</div></form>
