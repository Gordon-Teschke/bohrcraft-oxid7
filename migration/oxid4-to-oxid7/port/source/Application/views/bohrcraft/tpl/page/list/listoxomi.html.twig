{% set externalConsent = get_global_cookie("oxomiconsent") %}
{% capture append = "oxidBlock_content" %}<section class="container-xxl py-4"><div class="bohrcraft-external bohrcraft-oxomi" data-external-provider="oxomi" data-consented="{{ externalConsent == '1' ? '1' : '0' }}" data-language="{{ oView.getActiveLangAbbr() }}">
<h2 class="h3">{% if oView.getActiveLangAbbr() == 'en' %}Browse online{% else %}Online blättern{% endif %}</h2><p>{% if oView.getActiveLangAbbr() == 'en' %}The catalog view is provided by OXOMI (scireum GmbH) and is loaded only after your consent.{% else %}Die Katalogansicht wird von OXOMI (scireum GmbH) bereitgestellt und erst nach deiner Zustimmung geladen.{% endif %}</p>
<button type="button" class="btn btn-primary" data-load-external="oxomi">{% if oView.getActiveLangAbbr() == 'en' %}Allow and load OXOMI{% else %}OXOMI erlauben und laden{% endif %}</button><div class="universal-search-grid mt-4" hidden><div id="universal-search-input"></div><div id="universal-search-output" aria-live="polite"></div></div>
</div></section>{% endcapture %}
{% capture append = "oxidBlock_pageScript" %}<script src="{{ oViewConf.getResourceUrl('js/bohrcraft.js')|raw }}" defer></script>{% endcapture %}
{% include "page/list/list.html.twig" %}
